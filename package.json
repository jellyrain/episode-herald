{
  "name": "episode-herald",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "repository": "https://github.com/jellyrain/episode-herald.git",
  "productName": "追更小报",
  "version": "1.3.1",
  "license": "MIT",
  "description": "红果新季与新集追更管理器",
  "main": "./out/main/index.mjs",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsc -p tests/tsconfig.json && node --test .test-build/tests/*.test.js",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/build-tool.cjs setup",
    "build:unpack": "npm run build && node scripts/build-tool.cjs --dir",
    "build:win": "npm run build && node scripts/build-tool.cjs --win nsis --x64 --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "build:mac": "electron-vite build && node scripts/build-tool.cjs --mac",
    "build:linux": "electron-vite build && node scripts/build-tool.cjs --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/themes": "^3.3.0",
    "electron-updater": "6.8.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "lucide-react": "^1.69.0",
    "openhongguo": "0.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "libheif-js": "1.23.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
